[Unit]
Description=coScene teleop_server ROS2 Node
After=network.target cos_agent.service xrobotoolkit-pc-service.service
Wants=cos_agent.service xrobotoolkit-pc-service.service

[Service]
Type=simple
User=unitree
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=CYCLONEDDS_URI=file:///home/unitree/unitree_ros2/cyclonedds_ws/src/cyclonedds.xml
ExecStart=/bin/bash -c '\
  source /opt/ros/foxy/setup.bash && \
  source /home/unitree/unitree_ros2/cyclonedds_ws/install/setup.bash && \
  source /home/unitree/cos_ws/install/setup.bash && \
  exec ros2 launch teleop_server teleop_server.launch.py \
    urdf_file:=/home/unitree/cos_ws/src/g1_description/g1_29dof_mode_15_with_dex1_1.urdf'
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
