[Unit]
Description=Initialize and lock Unitree G1 head camera white balance
After=cos_teleop.service

[Service]
Type=oneshot
User=unitree
Environment=HEAD_CAMERA_STREAM_SETTLE_SECONDS=10
Environment=HEAD_CAMERA_AWB_WARM_SECONDS=5
ExecCondition=/bin/systemctl is-active --quiet cos_teleop.service
ExecStart=/usr/bin/timeout 30 /home/unitree/camera_tool/restore_head_awb_after_teleop.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
